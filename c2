static void print_order_lines(const char* text, int inner_vis) {
    char buf[256];
    strcpy(buf, text);
    char* saveptr = NULL;
    char* line;
#ifdef _WIN32
    line = strtok_s(buf, "\n", &saveptr);
#else
    line = strtok_r(buf, "\n", &saveptr);
#endif
    while (line) {
        box_line(line, inner_vis);
#ifdef _WIN32
        line = strtok_s(NULL, "\n", &saveptr);
#else
        line = strtok_r(NULL, "\n", &saveptr);
#endif
    }
}

