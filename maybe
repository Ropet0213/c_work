//보딩패스

//한글 너비 계산 (파이썬이랑 동일)
int display_width(const char *s) {
    int w = 0;
    const unsigned char *p = (const unsigned char *)s;
    while (*p) {
        if (*p < 0x80) {
            w++; p++;
        } else if ((*p & 0xE0) == 0xC0) {
            w += 2; p += 2;
        } else if ((*p & 0xF0) == 0xE0) {
            w += 2; p += 3;
        } else {
            w += 2; p += 4;
        }
    }
    return w;
}

//너비 맞춰서 패딩하는거 (파이썬에서 했던거)
void print_padded(const char *s, int width) {
    printf("%s", s);
    int pad = width - display_width(s);
    for (int i = 0; i < pad; i++) putchar(' ');
}

void print_ticket(const Reservation *r) {
    const char *dep_name = airports[find_airport(r->dep_iata)].name_ko;
    const char *arr_name = airports[find_airport(r->arr_iata)].name_ko;

    printf("\n");
    printf("  ┌─────────────────────────────────────────────┐\n");
    printf("  │       SKYLINE AIR  ·  BOARDING PASS         │\n");
    printf("  ├──────────────────────┬──────────────────────┤\n");
    printf("  │  FROM                │  TO                  │\n");
    printf("  │  %-19s │  %-19s │\n", r->dep_iata, r->arr_iata);
    printf("  │  "); print_padded(dep_name, 19); printf(" │  ");
    print_padded(arr_name, 19);                   printf(" │\n");
    printf("  ├──────────────────────┴──────────────────────┤\n");
    printf("  │                                             │\n");
    printf("  │  출발일     "); print_padded(r->dep_date, 16); printf("                │\n");
    printf("  │  도착일     "); print_padded(r->arr_date, 16); printf("                │\n");
    printf("  │  출발시간대  "); print_padded(r->dep_period, 4); printf("                           │\n");
    printf("  │                                             │\n");
    printf("  ├─────────────────────────────────────────────┤\n");
    printf("  │  Flight   %-10s                        │\n", r->flight_no);
    printf("  │  Booking  %-10s                        │\n", r->booking_id);
    printf("  └─────────────────────────────────────────────┘\n");
    printf("\n");
}

//예약화면

void view_reservation(void) {
    clear_screen();
    print_header();
    printf("  ┌──────────────────────────────────┐\n");
    printf("  │        📋  예약 확인             │\n");
    printf("  └──────────────────────────────────┘\n\n");

    if (res_count == 0) {
        printf("  저장된 예약이 없습니다.\n");
        pause_enter();
        return;
    }

    char input[20];
    printf("  예약번호를 입력하세요 (예: SKY-A3F2X7) : ");
    read_line(input, sizeof(input));
    to_upper(input);

    for (int i = 0; i < res_count; i++) {
        if (strcmp(reservations[i].booking_id, input) == 0) {
            printf("\n  ✅  예약을 찾았습니다!\n");
            print_ticket(&reservations[i]);
            pause_enter();
            return;
        }
    }

    printf("\n  ❌  해당 예약번호를 찾을 수 없습니다: %s\n", input);
    pause_enter();
}

//신규예약

void new_reservation(void) {
    if (res_count >= MAX_RESERVATIONS) {
        printf("  예약이 가득 찼습니다 (최대 %d건).\n", MAX_RESERVATIONS);
        pause_enter();
        return;
    }

    Reservation r;
    memset(&r, 0, sizeof(r));
    char input[64];
    int idx;

    //출발 공항
    clear_screen();
    print_header();
    printf("  ┌──────────────────────────────────┐\n");
    printf("  │        ✈  신규 예약 [1/5]        │\n");
    printf("  └──────────────────────────────────┘\n\n");
    printf("  출발 공항 IATA 코드를 입력하세요.\n");
    printf("  (예: ICN, NRT, LAX ...)\n\n");

    while (1) {
        printf("  출발 공항 > ");
        read_line(input, sizeof(input));
        to_upper(input);
        idx = find_airport(input);
        if (idx >= 0) {
            strcpy(r.dep_iata, airports[idx].code);
            strcpy(r.dep_airport, airports[idx].name_ko);
            printf("\n  ✅  %s  →  %s (%s, %s)\n",
                   r.dep_iata, r.dep_airport,
                   airports[idx].city, airports[idx].country);
            break;
        }
        printf("  ❌  알 수 없는 IATA 코드입니다. 다시 입력해주세요.\n");
    }

    //도착 공항
    printf("\n");
    printf("  도착 공항 IATA 코드를 입력하세요.\n\n");

    while (1) {
        printf("  도착 공항 > ");
        read_line(input, sizeof(input));
        to_upper(input);
        if (strcmp(input, r.dep_iata) == 0) {
            printf("  ❌  출발 공항과 도착 공항이 같을 수 없습니다.\n");
            continue;
        }
        idx = find_airport(input);
        if (idx >= 0) {
            strcpy(r.arr_iata, airports[idx].code);
            strcpy(r.arr_airport, airports[idx].name_ko);
            printf("\n  ✅  %s  →  %s (%s, %s)\n",
                   r.arr_iata, r.arr_airport,
                   airports[idx].city, airports[idx].country);
            break;
        }
        printf("  ❌  알 수 없는 IATA 코드입니다. 다시 입력해주세요.\n");
    }

    //출발 날짜
    clear_screen();
    print_header();
    printf("  ┌──────────────────────────────────┐\n");
    printf("  │        ✈  신규 예약 [2/5]        │\n");
    printf("  └──────────────────────────────────┘\n\n");
    printf("  경로 : %s (%s) → %s (%s)\n\n",
           r.dep_iata, r.dep_airport, r.arr_iata, r.arr_airport);
    printf("  출발 날짜를 입력하세요.\n");
    printf("  형식: YYYY MM DD   (예: 2026 09 17)\n\n");

    int dy, dm, dd;
    while (1) {
        printf("  출발 날짜 > ");
        read_line(input, sizeof(input));
        int ret = parse_date(input, &dy, &dm, &dd);
        if (ret == 0) {
            sprintf(r.dep_date, "%d년 %02d월 %02d일", dy, dm, dd);
            printf("\n  ✅  출발일 : %s\n", r.dep_date);
            break;
        } else if (ret == 1)
            printf("  ❌  형식이 올바르지 않습니다. (예: 2026 09 17)\n");
        else if (ret == 2)
            printf("  ❌  존재하지 않는 날짜입니다.\n");
        else if (ret == 3)
            printf("  ❌  과거 날짜는 예약할 수 없습니다.\n");
        else
            printf("  ❌  오늘로부터 1년 이내의 날짜만 입력 가능합니다.\n");
    }

    //도착 날짜
    printf("\n  도착 날짜를 입력하세요.\n");
    printf("  형식: YYYY MM DD   (예: 2026 09 20)\n\n");

    int ay, am, ad; //도착 날짜용 변수
    while (1) {
        printf("  도착 날짜 > ");
        read_line(input, sizeof(input));
        int ret = parse_date(input, &ay, &am, &ad);
        if (ret == 0) {
            if (!date_after_or_equal(dy,dm,dd,ay,am,ad)) {
                printf("  ❌  도착일은 출발일(%s) 이후여야 합니다.\n", r.dep_date);
                continue;
            }
            sprintf(r.arr_date, "%d년 %02d월 %02d일", ay, am, ad);
            printf("\n  ✅  도착일 : %s\n", r.arr_date);
            break;
        } else if (ret == 1)
            printf("  ❌  형식이 올바르지 않습니다. (예: 2026 09 20)\n");
        else if (ret == 2)
            printf("  ❌  존재하지 않는 날짜입니다.\n");
        else if (ret == 3)
            printf("  ❌  과거 날짜는 예약할 수 없습니다.\n");
        else
            printf("  ❌  오늘로부터 1년 이내의 날짜만 입력 가능합니다.\n");
    }

    //출발 시간대
    clear_screen();
    print_header();
    printf("  ┌──────────────────────────────────┐\n");
    printf("  │        ✈  신규 예약 [3/5]        │\n");
    printf("  └──────────────────────────────────┘\n\n");
    printf("  경로 : %s → %s\n", r.dep_iata, r.arr_iata);
    printf("  출발일 : %s   도착일 : %s\n\n", r.dep_date, r.arr_date);
    printf("  출발 시간대를 선택하세요.\n\n");
    printf("    1. 오전 출발 (00:00 ~ 11:59)\n");
    printf("    2. 오후 출발 (12:00 ~ 23:59)\n\n");

    while (1) {
        printf("  선택 (1/2) > ");
        read_line(input, sizeof(input));
        if (strcmp(input,"1") == 0) { strcpy(r.dep_period, "오전"); break; }
        if (strcmp(input,"2") == 0) { strcpy(r.dep_period, "오후"); break; }
        printf("  ❌  1 또는 2를 입력해주세요.\n");
    }
    printf("\n  ✅  %s 출발로 선택되었습니다.\n", r.dep_period);

    //예약번호, 항공편 번호 생성
    gen_booking_id(r.booking_id);
    gen_flight_no(r.dep_iata, r.arr_iata, r.flight_no);

    //저장
    reservations[res_count++] = r;

    //항공권 출력
    clear_screen();
    print_header();
    printf("  ┌──────────────────────────────────┐\n");
    printf("  │    🎉  예약이 완료되었습니다!   │\n");
    printf("  └──────────────────────────────────┘\n");

    print_ticket(&r);

    printf("  📌  예약번호 [ %s ] 를 기억해두세요!\n", r.booking_id);
    printf("      메인 화면의 '예약 확인'에서 조회하실 수 있습니다.\n");

    pause_enter();
}

