//줄 읽기
void read_line(char *buf, int size) {
    if (fgets(buf, size, stdin)) {
        buf[strcspn(buf, "\n")] = '\0';
    }
}

//대문자 변환
void to_upper(char *s) {
    for (; *s; s++) {
        if (*s >= 'a' && *s <= 'z') *s -= 32;
    }
}

//공항 찾기 (IATA)
int find_airport(const char *code) {
    for (int i = 0; i < IATA_COUNT; i++) {
        if (strcmp(airports[i].code, code) == 0) return i;
    }
    return -1;
}

//예약번호 랜덤생성
void gen_booking_id(char *out) {
    const char chars[] = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
    out[0]='S'; out[1]='K'; out[2]='Y'; out[3]='-';
    for (int i = 4; i < 10; i++) {
        out[i] = chars[rand() % (int)(sizeof(chars)-1)];
    }
    out[10] = '\0';
}

//항공편 번호 생성
void gen_flight_no(const char *dep, const char *arr, char *out) {
    const char *airlines[] = {"KE","OZ","LJ","TW","7C","BX","ZE","RS"};
    int idx = (dep[0] + arr[0] + dep[1] + arr[1]) % 8;
    int num = 100 + rand() % 900;
    sprintf(out, "%s%d", airlines[idx], num);
}

//날짜 검사
int is_leap(int y) {
    return (y%4==0 && y%100!=0) || (y%400==0);
}

int days_in_month(int m, int y) {
    int d[] = {0,31,28,31,30,31,30,31,31,30,31,30,31};
    if (m==2 && is_leap(y)) return 29;
    return d[m];
}

/* 날짜 문자열 파싱 및 검증
   형식: "YYYY MM DD"
   반환: 0=성공, 1=형식오류, 2=범위오류, 3=과거날짜, 4=1년초과 */
int parse_date(const char *s, int *y, int *m, int *d) {
    if (sscanf(s, "%d %d %d", y, m, d) != 3) return 1;
    if (*m<1||*m>12||*d<1||*d>days_in_month(*m,*y)) return 2;

    time_t now = time(NULL);
    struct tm *t = localtime(&now);
    int cy = t->tm_year+1900, cm = t->tm_mon+1, cd = t->tm_mday;

    //과거
    if (*y < cy || (*y==cy && *m<cm) || (*y==cy && *m==cm && *d<cd)) return 3;

    //1년 초과
    int future_y = cy+1, future_m = cm, future_d = cd;
    if (*y > future_y || (*y==future_y && *m>future_m) ||
        (*y==future_y && *m==future_m && *d>future_d)) return 4;

    return 0;
}

//출발일 이후인지 확인
int date_after_or_equal(int y1,int m1,int d1,int y2,int m2,int d2) {
    if (y2>y1) return 1;
    if (y2==y1 && m2>m1) return 1;
    if (y2==y1 && m2==m1 && d2>=d1) return 1;
    return 0;
}

