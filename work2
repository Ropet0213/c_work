/* ===================================================================
 * 실시간 맵 렌더링 시스템
 * =================================================================== */
static void render_map(Player* p) {
    char pc;
    switch (p->dir) {
    case DIR_UP:   pc = '^'; break;
    case DIR_DOWN: pc = 'v'; break;
    case DIR_LEFT: pc = '<'; break;
    default:       pc = '>'; break;
    }

    clear_screen();
    printf("  [DEBUG] 현재 오토바이 좌표: X = %d, Y = %d\n", p->x, p->y);
    printf("  조작: W(상)/A(좌)/S(하)/D(우) | SPACE = 목적지 도착 시 벨 누르기\n\n");

    for (int y = 0; y < MAP_ROWS; y++) {
        for (int x = 0; x < VISUAL_COLS; x++) {
            if (p->x == x && p->y == y) {
                putchar(pc);
            }
            else {
                if (strcmp(visual_map[y][x], "\x01") == 0) {
                    continue;
                }
                printf("%s", visual_map[y][x]);
            }
        }
        putchar('\n');
    }
    printf("\n  범례: ^v<>=오토바이 | #=도로 | 목적지 번호판 앞 '#' 칸에 주차하세요!\n");
    fflush(stdout);
}

static int is_walkable(int x, int y) {
    if (x < 0 || x >= VISUAL_COLS || y < 0 || y >= MAP_ROWS) return 0;
    if (strcmp(visual_map[y][x], "#") == 0) {
        return 1;
    }
    return 0;
}

/* 💡 peeked 플래그를 넘겨받아 노-픽 보너스 판정 연산 수행 */
static int play_delivery(Order* o, int peeked) {
    /* 피자가게 'S' 하단 도로 스폰 포인트 고정 */
    Player player = { 36, 17, DIR_UP };
    int target = o->building_idx;
    int tx = buildings[target].px;
    int ty = buildings[target].py;

    int min_dist = abs(tx - player.x) + abs(ty - player.y);

    clear_screen();
    int W = 46;
    printf("\n\n");
    box_top(W);
    box_line("  배달 준비 완료! 라이더님 안전운전하세요! ", W);
    box_empty(W);
    box_line("  ⚠️  주의: 주행 화면에 가이드는 없습니다. ", W);
    box_line("  배달 주소를 잘 기억하셨길 바래요!", W);
    box_empty(W);
    box_bot(W);
    fflush(stdout);
    SLEEP(2000);

    time_t t_start = time(NULL);
    int moves = 0, delivered = 0, correct = 0;

#ifndef _WIN32
    enable_raw_mode();
#endif
    while (!delivered) {
        render_map(&player);
        int ch = getch_wrapper();
        int nx = player.x, ny = player.y;

        if (ch == 'w' || ch == 'W') { ny--; player.dir = DIR_UP; }
        else if (ch == 's' || ch == 'S') { ny++; player.dir = DIR_DOWN; }
        else if (ch == 'a' || ch == 'A') { nx--; player.dir = DIR_LEFT; }
        else if (ch == 'd' || ch == 'D') { nx++; player.dir = DIR_RIGHT; }
        else if (ch == ' ') {
            delivered = 1;
            if (player.x == tx && player.y == ty) {
                correct = 1;
            }
        }

        if (!delivered && is_walkable(nx, ny)) {
            player.x = nx;
            player.y = ny;
            moves++;
        }
    }
#ifndef _WIN32
    disable_raw_mode();
#endif

    int elapsed = (int)(time(NULL) - t_start);
    int score = 0;
    clear_screen();
    int W2 = 46;
    printf("\n\n");
    if (correct) {
        int tb = (elapsed <= 15) ? 500 : (elapsed <= 30) ? 300 : 100;
        int mb = (moves <= min_dist + 5) ? 300 : (moves <= min_dist + 15) ? 150 : 50;
        int pb = (!peeked) ? 200 : 0; /* 💡 재확인 안 했을 시 암기 보너스 200점 지급 */
        
        score = 200 + tb + mb + pb; /* 한 스테이지 만점: 1200점 */

        box_top(W2);
        box_line("*** 🎯 정확한 배달 성공! ***", W2);
        box_empty(W2);
        { char tmp[64]; snprintf(tmp, sizeof(tmp), "  기억해 낸 건물: %s", buildings[target].name); box_line(tmp, W2); }
        { char tmp[64]; snprintf(tmp, sizeof(tmp), "  배달 소요 시간: %3d 초", elapsed); box_line(tmp, W2); }
        { char tmp[64]; snprintf(tmp, sizeof(tmp), "  오토바이 조작: %3d 번", moves);   box_line(tmp, W2); }
        box_empty(W2);
        box_line("  기본 성공 점수   :  200", W2);
        { char tmp[64]; snprintf(tmp, sizeof(tmp), "  신속 타임 보너스 :  %3d", tb); box_line(tmp, W2); }
        { char tmp[64]; snprintf(tmp, sizeof(tmp), "  최단 경로 보너스 :  %3d", mb); box_line(tmp, W2); }
        { char tmp[64]; snprintf(tmp, sizeof(tmp), "  암기 보너스:  %3d", pb); box_line(tmp, W2); }
        box_line("  ----------------------------", W2);
        { char tmp[64]; snprintf(tmp, sizeof(tmp), "  획득한 스코어    : %4d 점", score); box_line(tmp, W2); }
        box_bot(W2);
    }
    else {
        box_top(W2);
        box_line("XXX 🚨 오배송 발생 (배달 실패) XXX", W2);
        box_empty(W2);
        box_line("  라이더님 지금 뭐하시는거에요? ", W2);
        { char tmp[96]; snprintf(tmp, sizeof(tmp), "  %s 인데요. 혹시, 제 말 못알아들으셨나요?", buildings[target].name); box_line(tmp, W2); }
        box_line("  이번 피자는 내가 배상해야했다... ", W2);
        box_line("  이번 스테이지 획득 점수 : 0 점", W2);
        box_bot(W2);
    }
    press_any_key();
    return score;
}

