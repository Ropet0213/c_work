 * 메인 루프 제어 시스템
 * =================================================================== */
int main(void) {
    setlocale(LC_ALL, "");
    srand((unsigned int)time(NULL));
    init_building_data();

    while (1) {
        if (!main_menu()) {
            clear_screen();
            printf("\n\n  피자 러시(암기 모드)를 종료합니다. 이용해 주셔서 감사합니다!\n\n");
            break;
        }
        total_score = 0;

        generate_random_orders();

        for (int i = 0; i < MAX_ORDERS; i++) {
            show_order(&orders[i], i + 1);
            int peeked = ask_repeat(&orders[i]); /* 재확인 여부를 변수에 기록 */
            order_scores[i] = play_delivery(&orders[i], peeked); /* 배달 엔진으로 플래그 전달 */
            total_score += order_scores[i];
        }
        show_results();
    }
    return 0;
}
