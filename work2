static void generate_random_orders(void) {
    int used[NUM_BUILDINGS] = { 0 };

    for (int i = 0; i < MAX_ORDERS; i++) {
        int b_idx;
        do {
            b_idx = rand() % NUM_BUILDINGS;
        } while (used[b_idx]);
        used[b_idx] = 1;

        orders[i].building_idx = b_idx;

        /* 🎲 해당 건물의 대사 풀(Pool)에서 무작위 대사 한 줄을 매칭 */
        int d_idx = rand() % MAX_DIALOGUES;

        snprintf(orders[i].order_text, sizeof(orders[i].order_text),
            DIALOGUE_POOL[b_idx][d_idx],
            buildings[b_idx].address, buildings[b_idx].landmark);
    }
}

