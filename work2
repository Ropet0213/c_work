static void build_visual_matrix(void) {
    for (int y = 0; y < MAP_ROWS; y++) {
        const unsigned char* p = (const unsigned char*)ORIGINAL_MAP[y];
        int x = 0;
        while (*p && x < VISUAL_COLS) {
            int len = 0;
            int width = 1;

            if (*p < 0x80) { len = 1; width = 1; }
            else if ((*p & 0xE0) == 0xC0) { len = 2; width = 1; }
            else if ((*p & 0xF0) == 0xE0) {
                len = 3;
                if (*p >= 0xEA && *p <= 0xED) { width = 2; }
                else { width = 1; }
            }
            else { len = 4; width = 2; }

            memcpy(visual_map[y][x], p, len);
            visual_map[y][x][len] = '\0';
            p += len;

            if (width == 2 && x + 1 < VISUAL_COLS) {
                strcpy(visual_map[y][x + 1], "\x01");
                x += 2;
            }
            else { x += 1; }
        }
    }
}

