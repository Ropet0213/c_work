        char tmp[64];
        snprintf(tmp, sizeof(tmp), "  STAGE %d 점수 :  %4d 점", i + 1, order_scores[i]);
        box_line(tmp, W);
    }
    box_line("------------------------------------------", W);
    { char tmp[64]; snprintf(tmp, sizeof(tmp), "  최종 총합 점수 :  %d 점 / 3600 점", total_score); box_line(tmp, W); }
    box_empty(W);

    /* 💡 S등급 컷 상향 조절: 만점 3600점 중 3300점 이상 (실수 여유 거의 없음) */
    const char* grade;
    if (total_score >= 3300)      grade = "S - 인간 내비게이션 마스터 (완벽한 암기와 주행!)";
    else if (total_score >= 2600) grade = "A - 기억력 좋은 베테랑 라이더";
    else if (total_score >= 1600) grade = "B - 메모지가 필요한 배달원";
    else                          grade = "D - 기억력 훈련 재이수 필요";

    { char tmp[64]; snprintf(tmp, sizeof(tmp), "  종합 메모리 평가: %s", grade); box_line(tmp, W); }
    box_empty(W);
    box_bot(W);
    press_any_key();
}

