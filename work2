/* ===================================================================
 * 가시적 문자열 처리를 위한 유틸리티 (HUD 박스 유지용)
 * =================================================================== */
static int is_hangul_start(unsigned char c) {
    return (c >= 0xEA && c <= 0xED);
}

static int vis_width(const char* s) {
    int w = 0;
    const unsigned char* p = (const unsigned char*)s;
    while (*p) {
        if (*p < 0x80) { w++; p++; }
        else if ((*p & 0xE0) == 0xC0) { w++; p += 2; }
        else if ((*p & 0xF0) == 0xE0) { w += is_hangul_start(*p) ? 2 : 1; p += 3; }
        else { w += 2; p += 4; }
    }
    return w;
}

static void vis_ljust(char* buf, int buf_size, const char* s, int total_vis) {
    int w = vis_width(s);
    int pad = total_vis - w;
    if (pad < 0) pad = 0;
    int slen = (int)strlen(s);
    if (slen >= buf_size) slen = buf_size - 1;
    memcpy(buf, s, (size_t)slen);
    int i;
    for (i = 0; i < pad && slen + i + 1 < buf_size; i++) buf[slen + i] = ' ';
    buf[slen + i] = '\0';
}

static void box_line(const char* content, int inner_vis) {
    char tmp[256];
    vis_ljust(tmp, (int)sizeof(tmp), content, inner_vis);
    printf("  | %s |\n", tmp);
}

static void box_top(int inner_vis) {
    printf("  +");
    for (int i = 0; i < inner_vis + 2; i++) putchar('-');
    printf("+\n");
}
static void box_bot(int inner_vis) { box_top(inner_vis); }
static void box_empty(int inner_vis) {
    char tmp[256];
    memset(tmp, ' ', (size_t)(inner_vis < 254 ? inner_vis : 254));
    tmp[inner_vis < 254 ? inner_vis : 254] = '\0';
    printf("  | %s |\n", tmp);
}

